# Copie para .env. Nunca versione o .env de verdade.
AMBIENTE=dev

DATABASE_URL=postgresql+psycopg://assessoria:assessoria@127.0.0.1:5432/assessoria
TEST_DATABASE_URL=postgresql+psycopg://assessoria:assessoria@127.0.0.1:5432/assessoria_test

# Em produção precisa ter 32+ caracteres e não pode ser o padrão — a app
# se recusa a subir. Gere com: openssl rand -hex 32
JWT_SEGREDO=troque-em-producao
JWT_MINUTOS_ACESSO=30
JWT_DIAS_REFRESH=30

FUSO_PADRAO=America/Sao_Paulo
MOEDA_PADRAO=BRL
